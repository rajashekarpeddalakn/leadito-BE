# Server
PORT=8000
NODE_ENV=development

# Database (used by config/config.js)
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=Leadito
DB_HOST=127.0.0.1
DB_PORT=5432
# Alternatively, set a single connection string instead of the DB_* vars above:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth
ADMIN_JWT_SECRET=
USER_JWT_SECRET=

# Razorpay — optional, not currently integrated/used. Only needed if you
# turn on the /api/subscription/create-order and /verify-payment routes.
# The active payment flow is manual proof upload (/api/subscription/manual-payment).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# File storage — Vercel Blob (replaces AWS S3).
# Create a Blob store in the Vercel dashboard (Storage tab) and attach it
# to this project; Vercel then injects BLOB_READ_WRITE_TOKEN automatically
# in deployed environments. For local dev, copy the token from the
# dashboard (Storage > your store > .env.local tab) into this var.
BLOB_READ_WRITE_TOKEN=

# Firebase Admin — base64-encode the full service account JSON file:
#   base64 -w0 firebase-service-account.json
# and paste the result here. Required in serverless/Vercel deployments
# where there is no writable local file for the service account.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Set to "true" to run sequelize.sync({ alter: true }) on boot (local/dev only).
# Leave unset/false in production — use migrations instead.
DB_SYNC_ON_BOOT=false
